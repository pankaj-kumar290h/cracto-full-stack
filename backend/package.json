{
  "name": "release-checklist-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch src/index.js",
    "build": "prisma generate",
    "start": "prisma migrate deploy && node src/index.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "stress": "node stress/run.js"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@prisma/client": "^5.20.0",
    "prisma": "^5.20.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "autocannon": "^7.15.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@apollo/protobufjs@1.2.8": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
